# 2
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit


# 3
df = pd.read_csv("solar_system.csv")


# 4
print(df.shape)
print(df.head(5))
print(df.tail(5))
print(df.columns)
print(df["Attribute"])

# There are 20 rows and 11 columns


# 5
orbital_period = df.iloc[10, 1:].astype(float).values
perihelion = df.iloc[8, 1:].astype(float).values
aphelion = df.iloc[9, 1:].astype(float).values


# 6
# Perihelion: the point in an orbit around the sun that is closest to the sun.
# Aphelion: the point in an orbit around the sun that is farthest from the sun.
# Semi-major axis: half the distance of the longest diameter in an ellipse


# 7
semi_major_axis = (perihelion + aphelion) / 2


# 8
semi_major_axis_series = pd.Series(semi_major_axis.values, index=df.columns[1:], name="Semi-major axis (km)")
print(semi_major_axis_series)



